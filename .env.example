# ==============================================================================
# MULTI-AGENT RAG ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- REASONING ENGINE (GROQ) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_secondary_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- EMBEDDINGS (GOOGLE GEMINI) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- VECTOR DATABASE (QDRANT CLUSTER) ---
QDRANT_URL=https://your-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=enterprise_rag

# --- WEB SEARCH ENGINE ---
# Optional: If provided, Tavily is used as the primary search engine.
# If omitted or rate-limited, the system automatically falls back to DuckDuckGo search.
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# --- OBSERVABILITY & DISTRIBUTED TRACING ---
LOG_LEVEL=INFO
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=multi_agent_rag_assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- LOGFIRE TELEMETRY ---
# LOGFIRE_TOKEN=your_logfire_token_here

